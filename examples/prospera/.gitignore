/node_modules
.pnpm-store/

# next.js
/.next*/
/out/

# typescript incremental cache (tsc --noEmit)
*.tsbuildinfo

# misc
.DS_Store
.orchestrator-release-age-verified

# local env files
.env.local
.env.*.local
.env
.env.production

