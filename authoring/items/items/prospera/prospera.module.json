{
  "$schema": "../../../../.sitecore/schemas/ModuleFile.schema.json",
  "namespace": "Project.prospera",
  "description": "All Prospera (starter / starter-collection) site and org serialized items — content, templates, branches, renderings, placeholders, settings, media, datasources.",
  "items": {
    "includes": [
      {
        "name": "prospera.content",
        "path": "/sitecore/content/starter-collection",
        "allowedPushOperations": "CreateOnly",
        "scope": "itemAndDescendants"
      },
      {
        "name": "prospera.templates.project",
        "path": "/sitecore/templates/Project",
        "allowedPushOperations": "CreateUpdateAndDelete",
        "scope": "itemAndDescendants"
      },
      {
        "name": "prospera.templates.branches.project",
        "path": "/sitecore/templates/Branches/Project",
        "allowedPushOperations": "CreateUpdateAndDelete",
        "scope": "itemAndDescendants"
      },
      {
        "name": "prospera.layout.renderings.project",
        "path": "/sitecore/Layout/Renderings/Project",
        "allowedPushOperations": "CreateUpdateAndDelete",
        "scope": "itemAndDescendants"
      },
      {
        "name": "prospera.layout.placeholders.project",
        "path": "/sitecore/Layout/Placeholder Settings/Project",
        "allowedPushOperations": "CreateUpdateAndDelete",
        "scope": "itemAndDescendants"
      },
      {
        "name": "prospera.layout.layouts.project",
        "path": "/sitecore/Layout/Layouts/Project",
        "allowedPushOperations": "CreateUpdateAndDelete",
        "scope": "itemAndDescendants"
      },
      {
        "name": "prospera.settings.project",
        "path": "/sitecore/system/Settings/Project",
        "allowedPushOperations": "CreateUpdateAndDelete",
        "scope": "itemAndDescendants"
      },
      {
        "name": "prospera.media.project",
        "path": "/sitecore/media library/Project",
        "allowedPushOperations": "CreateOnly",
        "scope": "itemAndDescendants"
      }
    ]
  }
}
